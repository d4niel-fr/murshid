# Port for the local Node server (pnpm dev)
PORT=8787
# Supabase JWT secret (Project Settings > API > JWT Secret). HS256 verification.
# Leave empty in local dev to fall back to dev auth mode.
SUPABASE_JWT_SECRET=
# Expected JWT audience (Supabase default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
# Auth mode: "jwt" (verify Supabase tokens) or "dev" (accept x-dev-user-id header).
# Defaults to "dev" when SUPABASE_JWT_SECRET is empty and NODE_ENV != production.
AUTH_MODE=dev
# Shared secret the inbound-email provider sends in the x-inbox-secret header on POST /inbox/email
INBOX_WEBHOOK_SECRET=change-me-dev-only
# Domain used for per-student forwarding addresses: inbox+<student_id>@<domain>
INBOX_DOMAIN=inbox.murshid.local
# Base URL used to build OAuth callback placeholders for /connections
PUBLIC_API_URL=http://localhost:8787
# Seed the in-memory repository with synthetic data on boot (true/false)
SEED_DATA=true

# Chat model (agent-gateway): mock = rules only, openrouter = free OpenRouter models with rules fallback
GATEWAY_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Validation survey (Supabase): public URL + anon key (insert-only RLS); the results RPC checks SURVEY_ADMIN_CODE
SUPABASE_URL=
SUPABASE_ANON_KEY=
SURVEY_ADMIN_CODE=
# Public demo deployments: admin data (platform admin, school admin, survey results, AI status) needs this passcode
# in the x-admin-passcode header. Leave empty in local development.
ADMIN_PASSCODE=
# Extra CORS origins (comma-separated), e.g. the deployed web and admin URLs
CORS_ORIGINS=
