# @murshid/privacy — no secrets are needed to run tests.
# Pepper for tombstone subject hashes (random 32+ bytes, from the vault in prod).
PRIVACY_TOMBSTONE_PEPPER=change-me-dev-only
# Guardian OTP settings
GUARDIAN_OTP_TTL_MINUTES=15
GUARDIAN_OTP_MAX_ATTEMPTS=5
# Age-gate anti-retry lock
AGE_GATE_LOCK_DAYS=30
# UAE PASS (placeholder — not wired in this phase)
UAE_PASS_CLIENT_ID=
UAE_PASS_REDIRECT_URI=
UAE_PASS_ENV=staging
