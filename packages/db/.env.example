# Used by apps that construct a Supabase client and hand it to SupabaseDriver.
# This package itself reads no env vars; tests run fully in memory / in PGlite.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
# Backend jobs only (bypasses RLS). Never ship to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=replace-me
