# ---- mode -------------------------------------------------------------
# mock (default): every channel records to an in-memory outbox; nothing leaves the machine.
# live: real Expo / Resend / WhatsApp calls. Per-channel override: NOTIFY_<CHANNEL>_MODE=mock|live
NOTIFY_MODE=mock
NOTIFY_PUSH_MODE=
NOTIFY_EMAIL_MODE=
NOTIFY_WHATSAPP_MODE=

# ---- Expo push (expo-server-sdk) ---------------------------------------
# Optional: only needed if "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ---- Email (Resend REST API) -------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Murshid <reminders@example.com>"
RESEND_REPLY_TO=

# ---- WhatsApp Cloud API (Meta) -----------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Scheduler ---------------------------------------------------------
# Shared secret for the plain HTTP cron handler (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# Only if you wire the Inngest function definitions (apps/api owns the Inngest client).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Quiet hours (local times in NOTIFY_TIMEZONE) ----------------------
NOTIFY_TIMEZONE=Asia/Dubai
# 0=Sun ... 6=Sat. UAE schools: Mon-Fri.
QUIET_SCHOOL_DAYS=1,2,3,4,5
QUIET_SCHOOL_START=07:30
QUIET_SCHOOL_END=14:30
QUIET_SCHOOL_NIGHT_CUTOFF=21:30
QUIET_WEEKEND_NIGHT_CUTOFF=22:30
QUIET_MORNING_END=06:30
# Comma-separated local dates with no school, e.g. 2026-12-02,2026-12-03
QUIET_HOLIDAYS=
# Channels quiet hours apply to (email / in_app are passive and excluded by default)
QUIET_CHANNELS=push,whatsapp
