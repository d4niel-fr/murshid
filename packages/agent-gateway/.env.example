# @murshid/agent-gateway — tests need NONE of these (mock provider only, no network).
GATEWAY_MODE=mock                 # mock (rules) | openrouter (free models; see OPENROUTER_MODELS)
STUDENT_MONTHLY_BUDGET_USD=1.00

# Direct providers (OpenAI-compatible endpoints)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_API_KEY=
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ANTHROPIC_API_KEY=
ANTHROPIC_OPENAI_BASE_URL=https://api.anthropic.com/v1
SELF_HOSTED_BASE_URL=http://localhost:8000/v1   # Falcon-H1-Arabic + embedder (vLLM/TGI)
SELF_HOSTED_API_KEY=

# Proxies
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
