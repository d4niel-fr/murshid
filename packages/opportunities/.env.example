# @murshid/opportunities — all optional; defaults shown.
# User-Agent sent by the crawler (keep it honest and include a contact URL).
CRAWLER_USER_AGENT="MurshidBot/0.1 (+https://murshid.example/bot; student-opportunities crawler)"
# Minimum milliseconds between two requests to the same host (robots.txt Crawl-delay wins if larger).
CRAWLER_MIN_INTERVAL_MS=2000
# Node 22 only: make global fetch honour HTTP(S)_PROXY (needed in proxied sandboxes/CI).
# NODE_USE_ENV_PROXY=1
