# packages/connectors — all values are placeholders. Never commit real secrets.

# Token vault: AES-256-GCM key, 32 random bytes base64 (openssl rand -base64 32)
CONNECTORS_VAULT_KEY=

# Google (Classroom + Calendar share one OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Microsoft Entra (multi-tenant app). MS_TENANT_ID defaults to "organizations".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
MS_TENANT_ID=organizations

# ManageBac: per-school tokens are stored in the vault, not here. Optional regional host.
MANAGEBAC_API_HOST=https://api.managebac.com

# ICS export feed: HMAC secret for webcal subscribe URLs
ICS_FEED_SECRET=

# UAE PASS — staging only until SP onboarding + trade licence.
# Staging test client credentials are published in docs.uaepass.ae (Testing Credentials for POC).
UAEPASS_ENV=staging
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=
UAEPASS_REDIRECT_URI=http://localhost:3000/oauth/uaepass/callback
UAEPASS_ACR_VALUES=urn:safelayer:tws:policies:authentication:level:low
# Must stay false until UAE PASS production onboarding is approved
UAEPASS_PRODUCTION_APPROVED=false

# LinkedIn (Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback

# Edlink (skeleton)
EDLINK_CLIENT_ID=
EDLINK_CLIENT_SECRET=
EDLINK_REDIRECT_URI=http://localhost:3000/oauth/edlink/callback
