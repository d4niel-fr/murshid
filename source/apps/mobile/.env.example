# Base URL of apps/api. Leave empty to run fully standalone on the mock adapter (synthetic data).
EXPO_PUBLIC_API_URL=
# Force the mock adapter even when EXPO_PUBLIC_API_URL is set (true|false).
EXPO_PUBLIC_USE_MOCK=true
# Supabase project (public anon values only — never service keys). Empty = placeholder sign-in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
