{
  "expo": {
    "name": "Murshid",
    "slug": "murshid",
    "scheme": "murshid",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "ae.murshid.app" },
    "android": { "package": "ae.murshid.app" },
    "web": { "bundler": "metro", "output": "single" },
    "extra": { "supportsRTL": true },
    "plugins": [
      "expo-router",
      "expo-localization",
      ["expo-image-picker", { "photosPermission": "Murshid uses your photos so you can add class notes and worksheets." }],
      "expo-document-picker"
    ],
    "experiments": { "typedRoutes": false }
  }
}
